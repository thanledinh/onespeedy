---
// Cuối mỗi trang: cuộn tiếp thì vòng tròn vẽ đầy và tự chuyển sang trang sau (như Lusion).
import { useT, path, nextPage, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const t = useT(lang);
const next = nextPage(page);
---

<section class="nextp" data-nextp data-shape="ring" data-place="center" data-opacity="0.18">
  <a class="nextp__link" href={path(lang, next)} data-nextp-link data-cursor={t.next.hint}>
    <span class="label">{t.next.label}</span>
    <svg class="nextp__ring" viewBox="0 0 100 100" fill="none" aria-hidden="true">
      <circle cx="50" cy="50" r="40" stroke="rgba(245,247,246,.08)" stroke-width="10"></circle>
      <circle
        cx="50"
        cy="50"
        r="40"
        stroke="#F5F7F6"
        stroke-width="10"
        pathLength="100"
        stroke-dasharray="0 100"
        transform="translate(0 100) scale(1 -1) rotate(58.6 50 50)"
        data-nextp-arc></circle>
      <circle cx="80.6" cy="24.3" r="5" fill="#18B6A4" data-nextp-dot opacity="0"></circle>
    </svg>
    <span class="nextp__hint">{t.next.hint}</span>
    <span class="nextp__title display">{t.nav[next]}</span>
  </a>
</section>
