---
import Logo from './Logo.astro';
import Btn from './Btn.astro';
import { useT, path, contact, hasPage, seoOps, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: PageKey | null;
}
const { lang, page } = Astro.props;
const t = useT(lang);
// SEO Ops là trang của máy chủ SEO Ops trên cùng tên miền; Bảng giá đứng ngay sau nó.
const links: { href: string; label: string; key?: PageKey }[] = [
  { href: path(lang, 'services'), label: t.nav.services, key: 'services' },
  { href: seoOps[lang], label: t.nav.seoOps },
  { href: path(lang, 'pricing'), label: t.nav.pricing, key: 'pricing' },
  ...(['work', 'about', 'contact'] as PageKey[]).map((k) => ({ href: path(lang, k), label: t.nav[k], key: k })),
];
const bookHref = contact.booking || path(lang, 'contact');
const other: Lang = lang === 'vi' ? 'en' : 'vi';
// Trang chỉ có bản tiếng Việt (Express): nút EN dẫn về trang chủ tiếng Anh
const samePage = (l: Lang) => (page && hasPage(l, page) ? path(l, page) : path(l, 'home'));
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__logo" href={path(lang, 'home')} aria-label={`OneSpeedy — ${t.nav.home}`}>
      <Logo class="logo-rev" />
      <Logo tone="color" class="logo-col" />
    </a>

    <nav class="nav-pill" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.key && page === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="header__right">
      <div class="lang" role="group" aria-label={t.nav.langLabel}>
        <a href={samePage('vi')} hreflang="vi" lang="vi" aria-current={lang === 'vi' ? 'true' : undefined}>VI</a>
        <a href={samePage('en')} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      </div>
      <Btn href={bookHref} size="sm">{contact.booking ? t.nav.book : t.nav.cta}</Btn>
      <button class="burger" type="button" aria-label={t.nav.menu} aria-expanded="false" aria-controls="mmenu" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mmenu" id="mmenu" data-mmenu>
  <ul class="mmenu__links">
    {
      [{ href: path(lang, 'home'), label: t.nav.home, key: 'home' as PageKey }, ...links].map((l, i) => (
        <li>
          <a href={l.href} aria-current={l.key && page === l.key ? 'page' : undefined}>
            <small>0{i + 1}</small>
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mmenu__foot">
    <span>{t.tagline}</span>
    <a class="link-arrow" href={samePage(other)} hreflang={other}>{other === 'en' ? 'English' : 'Tiếng Việt'}</a>
  </div>
</div>
