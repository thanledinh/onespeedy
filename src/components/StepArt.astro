---
// Hình minh hoạ nét mảnh cho 4 thẻ Quy trình (cùng chất với icon dịch vụ).
// .d = nét tự vẽ khi thẻ hiện ra (--d = độ trễ), .t = nét teal, .f = hiện dần, .dot / .tf = chấm đặc.
// Chuyển động bật bằng class is-in trên .step (xem initStepArt trong scripts/app.ts).
interface Props {
  i: number;
}
const { i } = Astro.props;
---

<svg
  class="step__art"
  viewBox="0 0 360 150"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    i === 0 && (
      <Fragment>
        {/* Khám phá: sơ đồ trang + kính lúp */}
        <rect class="d t" x="150" y="6" width="60" height="26" rx="6" />
        <path class="d" style="--d:.15s" d="M168 19h24" />
        <path class="d" style="--d:.3s" d="M180 32v20M60 52h240M60 52v18M140 52v18M220 52v18M300 52v18" />
        <rect class="d" style="--d:.55s" x="30" y="70" width="60" height="24" rx="5" />
        <rect class="d" style="--d:.65s" x="110" y="70" width="60" height="24" rx="5" />
        <rect class="d" style="--d:.75s" x="190" y="70" width="60" height="24" rx="5" />
        <rect class="d" style="--d:.85s" x="270" y="70" width="60" height="24" rx="5" />
        <path class="d" style="--d:.9s" d="M42 82h36M122 82h26M202 82h32M282 82h28" />
        <path class="d" style="--d:1s" d="M60 94v16M300 94v16" />
        <rect class="d" style="--d:1.1s" x="38" y="110" width="44" height="20" rx="4" />
        <rect class="d" style="--d:1.15s" x="278" y="110" width="44" height="20" rx="4" />
        <circle class="d t" style="--d:1.3s" cx="214" cy="118" r="13" />
        <path class="d t" style="--d:1.55s" d="M223.5 127.5 234 138" />
      </Fragment>
    )
  }
  {
    i === 1 && (
      <Fragment>
        {/* Thiết kế: khung giao diện, một khối đang được kéo vào chỗ */}
        <rect class="d" x="56" y="6" width="248" height="138" rx="8" />
        <path class="d" style="--d:.2s" d="M56 24h248" />
        <circle class="f dot" style="--d:.3s" cx="68" cy="15" r="2" />
        <circle class="f dot" style="--d:.35s" cx="77" cy="15" r="2" />
        <circle class="f dot" style="--d:.4s" cx="86" cy="15" r="2" />
        <path class="d" style="--d:.4s" d="M76 42h104M76 54h78" />
        <rect class="d t" style="--d:.6s" x="76" y="66" width="44" height="12" rx="6" />
        <rect class="d" style="--d:.5s" x="200" y="38" width="84" height="50" rx="4" />
        <path class="d" style="--d:.8s" d="M206 82l20-18 13 11 10-7 29 14" />
        <circle class="d" style="--d:.9s" cx="266" cy="51" r="4" />
        <rect class="d" style="--d:.9s" x="76" y="100" width="60" height="32" rx="4" />
        <rect class="d" style="--d:1s" x="148" y="100" width="60" height="32" rx="4" />
        <rect class="d" style="--d:1.1s" x="220" y="100" width="64" height="32" rx="4" />
        <g class="drag f" style="--d:1.1s">
          <rect class="blk" x="220" y="100" width="64" height="32" rx="4" />
          <path class="cur" d="M272 116v16l4.5-4.5 3.5 8 3-1.4-3.5-8h6.5z" />
        </g>
      </Fragment>
    )
  }
  {
    i === 2 && (
      <Fragment>
        {/* Phát triển: khung code + đồng hồ tốc độ, kim chạy lên vùng xanh */}
        <rect class="d" x="16" y="10" width="172" height="130" rx="8" />
        <path class="d" style="--d:.2s" d="M16 28h172" />
        <circle class="f dot" style="--d:.3s" cx="28" cy="19" r="2" />
        <circle class="f dot" style="--d:.35s" cx="37" cy="19" r="2" />
        <circle class="f dot" style="--d:.4s" cx="46" cy="19" r="2" />
        <path class="d t" style="--d:.35s" d="M32 46h28" />
        <path class="d" style="--d:.45s" d="M68 46h56M44 62h76" />
        <path class="d t" style="--d:.6s" d="M44 78h36" />
        <path class="d" style="--d:.7s" d="M88 78h52M56 94h64M44 110h88" />
        <path class="d t" style="--d:.85s" d="M32 126h24" />
        <path class="d" style="--d:.5s" d="M214 116a56 56 0 0 1 112 0" />
        <path class="d" style="--d:.8s" d="M237.5 83.5l-4.3-4.3M270 70v-6M302.5 83.5l4.3-4.3" />
        <path class="d t" style="--d:1s" d="M298 67.5a56 56 0 0 1 28 48.5" />
        <g class="needle f" style="--d:.9s">
          <path d="M270 116 307.2 94.5" />
        </g>
        <circle class="f dot" style="--d:.9s" cx="270" cy="116" r="4" />
      </Fragment>
    )
  }
  {
    i === 3 && (
      <Fragment>
        {/* Ra mắt & tăng trưởng: trình duyệt có biểu đồ đi lên, nối ra quả địa cầu đang "sống" */}
        <rect class="d" x="16" y="10" width="196" height="130" rx="8" />
        <path class="d" style="--d:.2s" d="M16 28h196" />
        <circle class="f dot" style="--d:.3s" cx="28" cy="19" r="2" />
        <circle class="f dot" style="--d:.35s" cx="37" cy="19" r="2" />
        <circle class="f dot" style="--d:.4s" cx="46" cy="19" r="2" />
        <rect class="d" style="--d:.3s" x="64" y="15" width="104" height="8" rx="4" />
        <path class="d" style="--d:.45s" d="M36 124h156M36 124V48" />
        <path class="d t" style="--d:.7s" d="M40 114l30-12 26 6 30-24 28-8 34-30" />
        <circle class="f tf" style="--d:1.5s" cx="188" cy="46" r="3.5" />
        <path class="d t" style="--d:1s" d="M212 75h28" />
        <circle class="d" style="--d:1.1s" cx="286" cy="75" r="46" />
        <ellipse class="d" style="--d:1.3s" cx="286" cy="75" rx="18" ry="46" />
        <path class="d" style="--d:1.4s" d="M240 75h92M248 52h76M248 98h76" />
        <circle class="pulse tf" cx="318" cy="42" r="4" />
        <circle class="f tf" style="--d:1.6s" cx="318" cy="42" r="4" />
      </Fragment>
    )
  }
</svg>
