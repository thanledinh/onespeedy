---
// Màn che dùng cho: (1) màn mở đầu lần đầu vào web, (2) chuyển trang.
// Vòng tròn vẽ dần như "thanh tiến trình sắp hoàn tất" — đúng ý tưởng chữ O trong logo.
---

<div class="curtain" data-curtain aria-hidden="true" transition:persist="curtain">
  <div class="curtain__inner">
    <svg class="curtain__ring" viewBox="0 0 100 100" fill="none">
      <circle class="track" cx="50" cy="50" r="40" stroke-width="12"></circle>
      <!-- Cung chừa khoảng hở ở góc phải trên như logo -->
      <circle
        class="arc"
        cx="50"
        cy="50"
        r="40"
        stroke-width="12"
        pathLength="100"
        stroke-dasharray="0 100"
        transform="translate(0 100) scale(1 -1) rotate(58.6 50 50)"
        data-curtain-arc></circle>
      <circle cx="80.6" cy="24.3" r="6" fill="#18B6A4" data-curtain-dot opacity="0"></circle>
    </svg>
    <span class="curtain__count" data-curtain-count>000</span>
    <span class="curtain__label">Fast to build. Easy to find.</span>
  </div>
</div>
