---
// Trang 404 dùng chung cho mọi đường dẫn sai (nginx trả một file): tiếng Anh trước (bán thị trường nước ngoài), kèm dòng tiếng Việt.
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { useT, path } from '../i18n/ui';

const en = useT('en');
const vi = useT('vi');
---

<Base lang="en" page={null} title="404 — OneSpeedy" noindex neutral look="light">
  <section class="lh-phero lh-nf">
    <div class="container">
      <p class="lh-tag">404</p>
      <h1 class="lh-h1">{en.notFound.title}</h1>
      <p class="lh-lead">{en.notFound.text} <span lang="vi">{vi.notFound.text}</span></p>
      <div class="lh-actions">
        <Btn href={path('en', 'home')}>{en.notFound.back}</Btn>
        <Btn href={path('vi', 'home')} variant="ghost" icon={false}>{vi.notFound.back}</Btn>
      </div>
    </div>
  </section>
</Base>
