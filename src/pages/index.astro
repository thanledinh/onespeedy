---
// Trang gốc: chuyển tới /vi/ hoặc /en/ theo ngôn ngữ trình duyệt.
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OneSpeedy</title>
    <meta name="robots" content="noindex" />
    <link rel="alternate" hreflang="vi" href="/vi/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0B1720" />
    <script is:inline>
      (function () {
        var langs = navigator.languages || [navigator.language || 'vi'];
        var vi = langs.some(function (l) { return /^vi\b/i.test(l); });
        location.replace(vi ? '/vi/' : '/en/');
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/vi/" /></noscript>
    <style>
      html, body { margin: 0; height: 100%; background: #0b1720; }
    </style>
  </head>
  <body></body>
</html>
