---
// Trang gốc: chuyển sang /en/ (tiếng Anh trước, bán thị trường nước ngoài). nginx đã chuyển 302 trước khi tới file này;
// file này chỉ là dự phòng khi chạy chỗ khác (vd. astro preview).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OneSpeedy</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="/en/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="vi" href="/vi/" />
    <link rel="alternate" hreflang="x-default" href="/en/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0B1720" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <script is:inline>location.replace('/en/');</script>
    <style>
      html, body { margin: 0; height: 100%; background: #f5f7f6; }
    </style>
  </head>
  <body></body>
</html>
