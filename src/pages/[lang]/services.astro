---
// Dịch vụ, giao diện sáng: 4 khối (làm web, SEO Ops, CMS, Analytics), quy trình, câu hỏi thường gặp.
import Base from '../../layouts/Base.astro';
import Btn from '../../components/Btn.astro';
import Logo from '../../components/Logo.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import StepArt from '../../components/StepArt.astro';
import { useT, path, contact, seoOps, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const p = t.servicesPage;
const h = t.home;
const href = (to: string) => (to === 'seo' ? seoOps[lang] : path(lang, to as 'work' | 'contact'));
---

<Base lang={lang} page="services" look="light">
  <section class="lh-phero">
    <div class="container">
      <p class="lh-tag" data-reveal>{p.label}</p>
      <h1 class="lh-h1" data-reveal>{p.titleA} <mark class="lh-mark">{p.titleB}</mark></h1>
      <p class="lh-lead" data-reveal>{p.lead}</p>
    </div>
  </section>

  {
    p.pillars.map((s) => {
      const dark = s.id === 'seo';
      return (
        <section class="lh-section lh-section--pillar" id={s.id}>
          <div class="container">
            <div class:list={['lh-pillar', dark && 'lh-pillar--dark lh-dark']} data-reveal>
              <div class="lh-pillar__text">
                <div class="lh-card__art lh-pillar__art" aria-hidden="true">
                  <ServiceIcon i={s.icon} />
                </div>
                {s.badge && <p class="lh-tag lh-tag--dark lh-card__badge">{s.badge}</p>}
                <h2 class="lh-h2 lh-pillar__title">
                  <mark class:list={['lh-mark', dark && 'lh-mark--light']}>{s.title}</mark>
                </h2>
                <p class="lh-pillar__lead">{s.text}</p>
                <a class="lh-more" href={href(s.to)}>
                  <i aria-hidden="true"><svg viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></i>
                  {s.cta}
                </a>
              </div>
              <div class="lh-pillar__list">
                <p class="lh-pillar__incl">{p.includes}</p>
                <ul class="lh-points lh-points--stack">
                  {
                    s.items.map((x) => (
                      <li>
                        <svg viewBox="0 0 18 18" aria-hidden="true">
                          <circle cx="9" cy="9" r="9" fill="var(--teal)" />
                          <path d="M5.2 9.2l2.5 2.4 5-5.2" fill="none" stroke="var(--navy)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        {x}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- QUY TRÌNH -->
  <section class="lh-section">
    <div class="container">
      <div class="lh-head">
        <div>
          <p class="lh-tag" data-reveal>{p.processLabel}</p>
          <h2 class="lh-h2 lh-head__title" data-reveal>{p.processTitle}</h2>
        </div>
        <p data-reveal>{h.processText}</p>
      </div>
      <ol class="lh-steps">
        {
          t.process.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step__num">0{i + 1}</span>
              <StepArt i={i} />
              <h3 class="h3">{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- CÂU HỎI THƯỜNG GẶP -->
  <section class="lh-section lh-section--top0">
    <div class="container lh-faq-wrap">
      <div>
        <p class="lh-tag" data-reveal>{p.faqLabel}</p>
        <h2 class="lh-h2 lh-split__title" data-reveal>{p.faqTitle}</h2>
      </div>
      <div class="lh-faq">
        {
          p.faq.map((f) => (
            <details data-reveal>
              <summary>
                {f.q}
                <span class="lh-faq__plus" aria-hidden="true" />
              </summary>
              <div class="lh-faq__a">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- LỜI MỜI CUỐI -->
  <section class="lh-section lh-section--flush">
    <div class="container">
      <div class="lh-cta" data-reveal>
        <div>
          <h2 class="lh-h2">
            {h.ctaTitleA} <mark class="lh-mark">{h.ctaTitleB}</mark>
          </h2>
          <p>{h.ctaText}</p>
          <div class="lh-actions">
            <Btn href={path(lang, 'contact')}>{t.nav.cta}</Btn>
            <Btn href={contact.booking || `mailto:${contact.email}`} variant="ghost" icon={false}>{contact.booking ? t.nav.bookLong : t.nav.emailUs}</Btn>
          </div>
        </div>
        <Logo kind="monogram" tone="color" class="lh-cta__mark" />
      </div>
    </div>
  </section>
</Base>
