---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import BigCta from '../../components/BigCta.astro';
import { useT, path, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const p = t.workPage;
const cta = { text: p.cta, href: path(lang, 'contact') };
---

<Base lang={lang} page="work">
  <section class="phero" data-shape="knot" data-place="corner">
    <div class="container">
      <p class="label" data-reveal>{p.label}</p>
      <h1 class="display" data-split>{p.titleA} <span class="thin">{p.titleB}</span></h1>
      <p class="lead" data-reveal>{p.lead}</p>
    </div>
  </section>

  <section class="section--tight" data-shape="knot" data-place="center" data-opacity="0.5">
    <div class="container">
      <div class="works works--pair">
        {p.templates.map((tpl) => <WorkCard tpl={tpl} lang={lang} badge={p.badge} cta={cta} />)}
      </div>
      <p class="works__note" data-reveal>{p.note}</p>
    </div>
  </section>

  <!-- Điểm chung của các mẫu -->
  <section class="section--tight">
    <div class="container">
      <p class="label" data-reveal>{p.commonTitle}</p>
      <ul class="incl__list works__common" data-reveal>
        {p.common.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  </section>

  <BigCta lang={lang} />
</Base>
