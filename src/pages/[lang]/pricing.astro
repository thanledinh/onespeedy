---
// Bảng giá SEO Ops, giao diện sáng: 4 gói, nút chuyển tháng / năm chỉ bằng CSS (radio + label), danh sách "gói nào cũng có", hỏi báo giá làm web, câu hỏi thường gặp.
import Base from '../../layouts/Base.astro';
import Btn from '../../components/Btn.astro';
import Logo from '../../components/Logo.astro';
import { useT, path, contact, seoOps, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const p = t.pricingPage;
const h = t.home;
---

<Base lang={lang} page="pricing" look="light">
  <section class="lh-phero">
    <div class="container">
      <p class="lh-tag" data-reveal>{p.label}</p>
      <h1 class="lh-h1" data-reveal>{p.titleA} <mark class="lh-mark">{p.titleB}</mark></h1>
      <p class="lh-lead" data-reveal>{p.lead}</p>
    </div>
  </section>

  <!-- BẢNG GIÁ -->
  <section class="lh-section lh-section--pillar">
    <div class="container">
      <div class="lh-price">
        <input class="lh-price__radio" type="radio" name="lh-billing" id="lh-bill-m" checked />
        <input class="lh-price__radio" type="radio" name="lh-billing" id="lh-bill-y" />
        <div class="lh-toggle">
          <label for="lh-bill-m">{p.monthly}</label>
          <label for="lh-bill-y">{p.yearly}</label>
        </div>

        <div class="lh-plans">
          {
            p.plans.map((pl) => (
              <article class:list={['lh-plan', pl.featured && 'lh-plan--featured lh-dark']}>
                <header class="lh-plan__head">
                  <div class="lh-plan__top">
                    <h2 class="lh-plan__name">{pl.name}</h2>
                    {pl.badge && <span class="lh-plan__badge">{pl.badge}</span>}
                  </div>
                  <p class="lh-plan__for">{pl.for}</p>
                </header>
                <div class="lh-plan__price">
                  <div class="lh-plan__m">
                    <p class="lh-plan__amount">
                      <strong>{pl.monthly}</strong>
                      <span>{pl.monthlyUnit}</span>
                    </p>
                    <p class="lh-plan__small">{pl.monthlyNote}</p>
                  </div>
                  <div class="lh-plan__y">
                    <p class="lh-plan__amount">
                      <strong>{pl.yearly}</strong>
                      <span>{pl.yearlyUnit}</span>
                    </p>
                    <p class="lh-plan__small">{pl.yearlyNote}</p>
                  </div>
                </div>
                <div class="lh-plan__btn">
                  <Btn
                    href={pl.id === 'dfy' ? path(lang, 'contact') : seoOps[lang]}
                    variant={pl.featured ? 'primary' : 'ghost'}
                    icon={false}
                  >
                    {pl.cta}
                  </Btn>
                </div>
                {pl.list.length > 0 ? (
                  <ul class="lh-plan__checks">
                    {pl.list.map((x) => (
                      <li>
                        <svg viewBox="0 0 18 18" aria-hidden="true">
                          <circle cx="9" cy="9" r="9" fill="var(--teal)" />
                          <path d="M5.2 9.2l2.5 2.4 5-5.2" fill="none" stroke="var(--navy)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        {x}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <dl class="lh-plan__limits">
                    {pl.limits.map((v, i) => (
                      <div>
                        <dt>{p.limitLabels[i]}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </article>
            ))
          }
        </div>
      </div>

      <div class="lh-included" data-reveal>
        <h2 class="lh-included__title">{p.includedTitle}</h2>
        <ul class="lh-points lh-included__list">
          {
            p.included.map((x) => (
              <li>
                <svg viewBox="0 0 18 18" aria-hidden="true">
                  <circle cx="9" cy="9" r="9" fill="var(--teal)" />
                  <path d="M5.2 9.2l2.5 2.4 5-5.2" fill="none" stroke="var(--navy)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {x}
              </li>
            ))
          }
        </ul>
      </div>
      <p class="lh-price__note">{p.note}</p>
    </div>
  </section>

  <!-- LÀM WEB, CMS, ANALYTICS: BÁO GIÁ THEO DỰ ÁN -->
  <section class="lh-section lh-section--pillar">
    <div class="container">
      <div class="lh-quote" data-reveal>
        <div>
          <h2 class="lh-quote__title">{p.quoteTitle}</h2>
          <p>{p.quoteText}</p>
        </div>
        <Btn href={path(lang, 'contact')}>{p.quoteCta}</Btn>
      </div>
    </div>
  </section>

  <!-- CÂU HỎI THƯỜNG GẶP -->
  <section class="lh-section">
    <div class="container lh-faq-wrap">
      <div>
        <p class="lh-tag" data-reveal>{p.faqLabel}</p>
        <h2 class="lh-h2 lh-split__title" data-reveal>{p.faqTitle}</h2>
      </div>
      <div class="lh-faq">
        {
          p.faq.map((f) => (
            <details data-reveal>
              <summary>
                {f.q}
                <span class="lh-faq__plus" aria-hidden="true" />
              </summary>
              <div class="lh-faq__a">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- LỜI MỜI CUỐI -->
  <section class="lh-section lh-section--flush">
    <div class="container">
      <div class="lh-cta" data-reveal>
        <div>
          <h2 class="lh-h2">
            {h.ctaTitleA} <mark class="lh-mark">{h.ctaTitleB}</mark>
          </h2>
          <p>{h.ctaText}</p>
          <div class="lh-actions">
            <Btn href={path(lang, 'contact')}>{t.nav.cta}</Btn>
            <Btn href={contact.booking || `mailto:${contact.email}`} variant="ghost" icon={false}>{contact.booking ? t.nav.bookLong : t.nav.emailUs}</Btn>
          </div>
        </div>
        <Logo kind="monogram" tone="color" class="lh-cta__mark" />
      </div>
    </div>
  </section>
</Base>
