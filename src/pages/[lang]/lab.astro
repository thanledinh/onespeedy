---
import Base from '../../layouts/Base.astro';
import BigCta from '../../components/BigCta.astro';
import { useT, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'vi' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const p = t.labPage;
---

<Base lang={lang} page="lab">
  <section class="phero lab-hero" data-shape="knot" data-place="hero">
    <div class="container">
      <p class="label" data-reveal>{p.label}</p>
      <h1 class="display" data-split>{p.titleA} <span class="thin">{p.titleB}</span></h1>
      <p class="lead" data-reveal>{p.lead}</p>
      <dl class="hud" data-reveal>
        <div><dt>{p.hud.particles}</dt><dd class="num" data-hud-count>—</dd></div>
        <div><dt>{p.hud.fps}</dt><dd class="num" data-hud-fps>—</dd></div>
        <div><dt>{p.hud.engine}</dt><dd class="num">WebGL · Three.js</dd></div>
      </dl>
    </div>
  </section>

  {
    p.experiments.map((x, i) => (
      <section
        class:list={['exp', i % 2 === 1 && 'exp--flip']}
        data-shape={x.shape}
        data-place={i % 2 === 1 ? 'left' : 'right'}
      >
        <div class="container">
          <div class="exp__text">
            <span class="exp__no num">Exp. 0{i + 1}</span>
            <h2 class="h2" data-split>{x.title}</h2>
            <p class="lead" data-reveal>{x.text}</p>
            <div class="exp__meta" data-reveal>
              <ul class="exp__tags">
                {x.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              <button class="btn btn--ghost btn--sm" type="button" data-explode data-magnetic>
                <span class="btn__label"><span>{p.explode}</span><span aria-hidden="true">{p.explode}</span></span>
              </button>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section--tight">
    <div class="container">
      <p class="lab-note" data-reveal>{p.note}</p>
    </div>
  </section>

  <BigCta lang={lang} />
</Base>
